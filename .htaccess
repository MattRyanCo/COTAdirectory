<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# --- Block files that must never be downloaded from the website (403 Forbidden) ---
# backups/   database dumps: for the server administrator only.
# downloads/ generated directory booklets: served by app-includes/download.php after sign-in.
# vendor/    third-party code.
RewriteRule ^(backups|downloads|vendor)(/|$) - [F,L]
# Hidden files and folders (.env holds the database password; .git, .github, ...),
# except .well-known, which certificate renewal (e.g. Let's Encrypt) needs.
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
# Logs, SQL dumps, CSV files (older versions of Import left uploaded member data in
# app-includes/uploads/), docs and config files anywhere on the site, and the old phpinfo page.
RewriteRule \.(log|sql|csv|md|yml|yaml|xml|lock)$ - [F,L,NC]
RewriteRule (^|/)(composer\.json|phpinfo\.php)$ - [F,L,NC]

# --- Everything else: real files are served; other addresses go to the app ---
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
